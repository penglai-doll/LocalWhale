<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ShellTitleBarBackgroundBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ShellOverlayBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="ShellCardBackgroundBrush" Color="#F9F9F9" />
            <SolidColorBrush x:Key="ShellCardBorderBrush" Color="#15000000" />
            <SolidColorBrush x:Key="ShellAccentBrush" Color="#005FB8" />
            <SolidColorBrush x:Key="ShellAccentForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ShellMutedForegroundBrush" Color="#6B6B6B" />
            <x:Double x:Key="WhaleGirlDecorationOpacity">0</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ShellTitleBarBackgroundBrush" Color="#00000000" />
            <SolidColorBrush x:Key="ShellOverlayBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="ShellCardBackgroundBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="ShellCardBorderBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="ShellAccentBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="ShellAccentForegroundBrush" Color="#101010" />
            <SolidColorBrush x:Key="ShellMutedForegroundBrush" Color="#C4C4C4" />
            <x:Double x:Key="WhaleGirlDecorationOpacity">0</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ShellTitleBarBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellOverlayBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ShellAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ShellAccentForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ShellMutedForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <x:Double x:Key="WhaleGirlDecorationOpacity">0</x:Double>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
