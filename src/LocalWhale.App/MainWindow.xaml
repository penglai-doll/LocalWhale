<Window
    x:Class="LocalWhale.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="{ThemeResource ShellTitleBarBackgroundBrush}"
            Subtitle="LocalWhale 0.1.1 · Harness —"
            Title="LocalWhale">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Brand/LocalWhaleMark-24.png" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse
                        x:Name="StatusDot"
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock
                        x:Name="ConnectionText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="正在启动" />
                    <Button
                        x:Name="RestartHarnessButton"
                        Width="36"
                        Height="32"
                        VerticalAlignment="Center"
                        Click="RestartHarnessButton_Click"
                        ToolTipService.ToolTip="重启 Harness（配置更改后需要重启 Web 界面时使用）">
                        <Button.Content>
                            <FontIcon Glyph="&#xE72C;" />
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="SettingsButton"
                        Width="36"
                        Height="32"
                        VerticalAlignment="Center"
                        Click="SettingsButton_Click"
                        ToolTipService.ToolTip="设置">
                        <Button.Content>
                            <FontIcon Glyph="&#xE713;" />
                        </Button.Content>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <WebView2
            x:Name="HarnessWebView"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            NavigationCompleted="HarnessWebView_NavigationCompleted" />

        <Grid
            x:Name="StartupOverlay"
            Grid.Row="1"
            Background="{ThemeResource ShellOverlayBackgroundBrush}">
            <Border
                x:Name="StartupCard"
                MaxWidth="920"
                Margin="32"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource ShellCardBackgroundBrush}"
                BorderBrush="{ThemeResource ShellCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="WhaleGirlPortraitColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        MinWidth="320"
                        MaxWidth="500"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Image
                                Width="40"
                                Height="40"
                                Source="ms-appx:///Assets/Brand/LocalWhaleMark-32.png" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="12" Foreground="{ThemeResource ShellMutedForegroundBrush}" Text="LOCALWHALE" />
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="本地 DeepSeek Harness" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock
                            x:Name="StartupTitle"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="正在唤醒 Harness"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="StartupDetail"
                            Foreground="{ThemeResource ShellMutedForegroundBrush}"
                            LineHeight="22"
                            Text="后台服务通过健康检查后会自动进入界面"
                            TextWrapping="Wrap" />
                        <ProgressRing
                            x:Name="StartupProgress"
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Left"
                            IsActive="True" />
                        <StackPanel
                            x:Name="RecoveryActions"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="Collapsed">
                            <Button Style="{StaticResource AccentButtonStyle}" Content="重试" Click="Retry_Click" />
                            <Button Content="打开日志" Click="OpenLogs_Click" />
                        </StackPanel>
                    </StackPanel>

                    <Image
                        x:Name="WhaleGirlPortrait"
                        Grid.Column="1"
                        MaxWidth="320"
                        MaxHeight="430"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Opacity="{ThemeResource WhaleGirlDecorationOpacity}"
                        Source="ms-appx:///Assets/Themes/WhaleGirl/WhaleGirlPortrait.png"
                        Stretch="Uniform"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Margin="0,0,24,24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Spacing="8">

            <InfoBar
                x:Name="ShellUpdateCard"
                Width="520"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational"
                Title="发现外壳新版本">
                <InfoBar.Content>
                    <StackPanel Margin="0,8,0,0" Spacing="8">
                        <ProgressBar
                            x:Name="ShellUpdateProgress"
                            Maximum="100"
                            Minimum="0"
                            Visibility="Collapsed" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="IgnoreShellUpdateButton"
                                Click="IgnoreShellUpdate_Click"
                                Content="忽略此版本" />
                            <Button Click="LaterShellUpdate_Click" Content="稍后" />
                        </StackPanel>
                    </StackPanel>
                </InfoBar.Content>
                <InfoBar.ActionButton>
                    <Button
                        x:Name="ShellUpdateActionButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="ShellUpdateActionButton_Click"
                        Content="下载更新" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                x:Name="UpdateInfoBar"
                Width="520"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational"
                Title="Harness 更新已就绪">
                <InfoBar.Content>
                    <StackPanel Margin="0,8,0,0" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button Content="忽略此版本" Click="IgnoreUpdate_Click" />
                        <Button Content="稍后" Click="LaterUpdate_Click" />
                    </StackPanel>
                </InfoBar.Content>
                <InfoBar.ActionButton>
                    <Button x:Name="ApplyUpdateButton" Style="{StaticResource AccentButtonStyle}" Content="更新" Click="ApplyUpdate_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

        </StackPanel>

    </Grid>
</Window>
