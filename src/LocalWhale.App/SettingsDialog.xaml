<ContentDialog
    x:Class="LocalWhale.App.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="设置"
    CloseButtonText="关闭"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="2,14,0,6" />
        </Style>
        <Style x:Key="SettingsCardIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SettingsCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsCardDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="2,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="540">
        <StackPanel Width="500" Spacing="4">

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="常规" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Margin="0,2,0,0"
                        Style="{StaticResource SettingsCardIconStyle}"
                        Glyph="&#xE7E8;" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="关闭时最小化到托盘" />
                        <TextBlock Style="{StaticResource SettingsCardDescriptionStyle}" Text="关闭窗口时保留托盘图标并在后台继续运行；关闭后可从托盘完全退出。" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="CloseToTrayToggle"
                        Grid.Column="2"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OffContent=""
                        OnContent=""
                        Toggled="CloseToTrayToggle_Toggled" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="外观" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Margin="0,2,0,0"
                        Style="{StaticResource SettingsCardIconStyle}"
                        Glyph="&#xE790;" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="外观主题" />
                        <TextBlock Style="{StaticResource SettingsCardDescriptionStyle}" Text="主题只影响 LocalWhale 本地客户端自己的标题栏、启动卡片和设置界面；WebView2 中的官方 Harness 界面保持原样。" />
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <RadioButton
                                x:Name="OriginalThemeRadio"
                                Checked="ThemeRadio_Checked"
                                Content="默认主题"
                                GroupName="VisualTheme" />
                            <RadioButton
                                x:Name="WhaleGirlThemeRadio"
                                Checked="ThemeRadio_Checked"
                                Content="鲸鱼娘主题"
                                GroupName="VisualTheme" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="更新" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Margin="0,2,0,0"
                        Style="{StaticResource SettingsCardIconStyle}"
                        Glyph="&#xE895;" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="自动检查本地客户端更新" />
                        <TextBlock
                            x:Name="ShellVersionRowText"
                            Style="{StaticResource SettingsCardDescriptionStyle}"
                            Text="当前 —" />
                        <TextBlock Style="{StaticResource SettingsCardDescriptionStyle}" Text="每天最多自动检查一次 GitHub 最新发布；更新下载并校验后，重启 LocalWhale 即自动安装新版。" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <ToggleSwitch
                            x:Name="ShellUpdateCheckToggle"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            Toggled="ShellUpdateCheckToggle_Toggled" />
                        <Button
                            x:Name="CheckShellUpdatesButton"
                            VerticalAlignment="Center"
                            Click="CheckShellUpdatesButton_Click"
                            Content="立即检查" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock
                x:Name="ShellCheckStatusText"
                Style="{StaticResource SettingsStatusTextStyle}"
                Text="" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Margin="0,2,0,0"
                        Style="{StaticResource SettingsCardIconStyle}"
                        Glyph="&#xE896;" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Harness 更新" />
                        <TextBlock
                            x:Name="HarnessVersionText"
                            Style="{StaticResource SettingsCardDescriptionStyle}"
                            Text="当前 —" />
                        <TextBlock Style="{StaticResource SettingsCardDescriptionStyle}" Text="检查官方 npm registry；更新前会在临时目录完成安装验证与冒烟测试。" />
                    </StackPanel>
                    <Button
                        x:Name="CheckHarnessUpdatesButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="CheckHarnessUpdatesButton_Click"
                        Content="检查更新" />
                </Grid>
            </Border>
            <TextBlock
                x:Name="HarnessCheckStatusText"
                Style="{StaticResource SettingsStatusTextStyle}"
                Text="" />

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="诊断" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Margin="0,2,0,0"
                        Style="{StaticResource SettingsCardIconStyle}"
                        Glyph="&#xED25;" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="日志" />
                        <TextBlock Style="{StaticResource SettingsCardDescriptionStyle}" Text="打开本地日志文件夹。日志经过脱敏，最多保留 14 天且不超过 50 MiB。" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="OpenLogsButton_Click"
                        Content="打开日志" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="关于" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Margin="0,2,0,0"
                        Style="{StaticResource SettingsCardIconStyle}"
                        Glyph="&#xE723;" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="LocalWhale" />
                        <TextBlock
                            x:Name="ShellVersionText"
                            Style="{StaticResource SettingsCardDescriptionStyle}"
                            Text="—" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="AboutButton_Click"
                        Content="关于" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
